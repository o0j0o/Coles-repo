# Copy to .env and change these.
APP_PASSWORD=choose-a-strong-password
# Optional: any long random string (e.g. from `openssl rand -hex 32`).
SESSION_SECRET=
TZ=America/Barbados
# Optional: turns on "Import from photo" (reading recipes from photos, PDFs and text).
# Get a key at https://console.anthropic.com. Each recipe read is one request, typically a few cents.
ANTHROPIC_API_KEY=
